{
  "name": "cut-youtube",
  "private": true,
  "version": "1.1.0",
  "description": "Tải video YouTube 1080p hàng loạt — đặt tên file và chọn thư mục cho từng link",
  "author": "Nguyễn Hoàng Duy",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"node server/index.js\" \"vite\"",
    "server": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js --serve-dist",
    "test": "node --test server/*.test.js src/*.test.js",
    "app": "vite build --config vite.electron.config.js && electron .",
    "app:build": "vite build --config vite.electron.config.js && electron-builder"
  },
  "build": {
    "appId": "com.hoangduy.youtube-download-tool",
    "productName": "Youtube Download Tool",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-app/**",
      "server/**",
      "electron/**",
      "package.json",
      "!**/*.test.js"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Youtube Download Tool"
    },
    "portable": {
      "artifactName": "YoutubeDownloadTool-portable-${version}.exe"
    }
  },
  "dependencies": {
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.0"
  }
}
